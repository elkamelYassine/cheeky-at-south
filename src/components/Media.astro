---
// Photos (open in the lightbox) and YouTube facades for one stop.
import photos from '../data/photos.json';
import videos from '../data/videos.json';

const { photoKey, videoIds = [], name, limit = 3 } = Astro.props;
const list = (photoKey && photos[photoKey]) || [];
const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const caption = (p) => `${esc(name)}${p.note ? ' (' + esc(p.note) + ')' : ''} · Photo: ${esc(p.credit)} · ${esc(p.license)} · <a href="${p.page}" target="_blank" rel="noopener">Wikimedia Commons</a>`;
const shown = list.slice(0, limit);
const vids = videoIds.filter((id) => videos[id]);
---
{(shown.length > 0 || vids.length > 0) && (
  <div class:list={['media', { solo: shown.length + vids.length === 1 }]}>
    {shown.map((p, i) => (
      <button
        type="button"
        class:list={['ph', { lead: i === 0 }]}
        data-full={p.src}
        data-alt={name}
        data-caption={caption(p)}
        aria-label={`Open photo of ${name}`}
      >
        {p.note && <span class="sim">{p.note}</span>}
        <img src={i === 0 ? p.src : p.thumb} width={p.w} height={p.h} alt={`${name}`} loading="lazy" decoding="async" />
      </button>
    ))}
    {vids.map((id) => (
      <button type="button" class="yt" data-yt={id} data-title={videos[id].title} aria-label={`Play video: ${videos[id].title}`}>
        <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" />
        <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M8 5v14l11-7z"/></svg></span>
        <span class="yt-meta"><b>{videos[id].title}</b><small>{videos[id].author} · YouTube</small></span>
      </button>
    ))}
  </div>
)}

<style>
  .media { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .ph, .yt { position: relative; padding: 0; border: 0; border-radius: 12px; overflow: hidden; cursor: zoom-in; background: var(--surface-2); height: clamp(130px, 13vw, 175px); aspect-ratio: 4 / 3; flex: 1 1 auto; max-width: 100%; }
  .ph.lead { aspect-ratio: 3 / 2; }
  .solo .ph { flex: 0 1 auto; height: clamp(180px, 24vw, 280px); }
  .sim { position: absolute; z-index: 1; left: 8px; bottom: 8px; padding: 1px 8px; border-radius: 999px; background: rgb(10 9 14 / 0.7); color: #fff; font: 600 0.68rem var(--f-mono); }
  .ph img, .yt img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .ph:hover img, .yt:hover img { transform: scale(1.05); }
  .yt { cursor: pointer; aspect-ratio: 16 / 9; }
  .yt::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(10 9 14 / 0.85), transparent 60%); }
  .play { position: absolute; z-index: 1; left: 12px; top: 12px; width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: #ff3d57; color: #fff; box-shadow: 0 4px 14px rgb(0 0 0 / 0.35); }
  .yt-meta { position: absolute; z-index: 1; left: 12px; right: 12px; bottom: 10px; display: grid; text-align: left; color: #fff; line-height: 1.25; }
  .yt-meta b { font-size: 0.85rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .yt-meta small { font-size: 0.72rem; opacity: 0.8; }
  .media :global(iframe) { flex: 1 1 100%; width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 12px; }
  @media (max-width: 520px) { .ph, .yt { height: 130px; } .yt { flex-basis: 100%; height: auto; } }
</style>
