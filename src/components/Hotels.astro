---
import Phone from './Phone.astro';
import Media from './Media.astro';
import { nights, trip } from '../data/trip.mjs';
import { tnd } from '../lib/budget.mjs';
---
<section class="section" id="hotels">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">All booked · 4 people</p>
      <h2>Where we sleep</h2>
      <p>
        Three nights on the road, then three nights by the sea in Hammam Sousse. Everything below is confirmed.
        Prices are totals for the four of you. Airbnb charged in euros, converted at 1 € ≈ 3.36 TND.
      </p>
    </div>

    {Object.entries(nights).map(([k, n]) => (
      <div class="night reveal">
        <h3 class="night-title"><span class="eyebrow">{n.label}</span>{n.area}</h3>
        <div class="opts">
          {n.options.map((o) => (
            <article class="opt pick" id={`hotel-${o.id}`}>
              <span class="pick-tag">Booked</span>
              <h4>{o.name}</h4>
              <p class="type">{o.type} · via {o.via}</p>
              <p class="price"><b class="mono">{o.approxPrice ? '≈ ' : ''}{tnd(o.total)}</b> <small>for the four of you</small></p>
              <p class="room mono">{o.approxPrice ? '≈ ' : ''}{Math.round(o.total / trip.crew)} TND per person{o.nightsCount ? ` · ${o.nightsCount} nights` : ''}</p>
              <dl class="facts">
                <div><dt>Check-in</dt><dd>{o.checkin}</dd></div>
                <div><dt>Checkout</dt><dd>{o.checkout}</dd></div>
                {o.rooms && <div><dt>Rooms</dt><dd>{o.rooms}</dd></div>}
                <div><dt>Meals</dt><dd>{o.meals}</dd></div>
                <div><dt>Payment</dt><dd>{o.paid}</dd></div>
              </dl>
              {o.phones.length > 0 && (
                <ul class="phones">{o.phones.map((p) => <li><Phone num={p.num} source={p.source} /></li>)}</ul>
              )}
              {o.contact && <p class="contact">Contact: <b>{o.contact}</b></p>}
              {o.web && <p class="contact"><a href={o.web} target="_blank" rel="noopener">See the listing on Airbnb</a></p>}
              <p class="onote">{o.note}</p>
              {o.photos && <Media photoKey={o.photos} name={o.name} limit={3} />}
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .night { margin-top: clamp(28px, 4vw, 48px); }
  .night-title { display: grid; gap: 4px; font-size: var(--step-2); margin-bottom: 16px; }
  .opts { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 14px; }
  .opt { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 20px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); min-width: 0; }
  .opt.pick { border: 2px solid var(--pink); }
  .pick-tag { position: absolute; top: -11px; left: 16px; padding: 1px 10px; border-radius: 999px; background: var(--pink); color: #fff; font: 600 0.7rem var(--f-mono); text-transform: uppercase; letter-spacing: 0.08em; }
  h4 { font: 700 var(--step-1) var(--f-display); }
  .type { color: var(--muted); font-size: 0.88rem; }
  .price { margin-top: 6px; }
  .price b { font-size: 1.6rem; }
  .price small, .room { color: var(--muted); font-size: 0.8rem; }
  .phones { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 6px; }
  .nophone { color: var(--muted); font-size: 0.88rem; margin-top: 8px; }
  .contact { font-size: 0.9rem; overflow-wrap: anywhere; }
  .onote { font-size: 0.88rem; color: var(--muted); margin-top: 4px; }
  .facts { display: grid; gap: 4px; margin: 8px 0 0; font-size: 0.88rem; }
  .facts div { display: grid; grid-template-columns: 6.5em minmax(0, 1fr); gap: 8px; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; }
  .opt :global(.media) { margin-top: auto; padding-top: 12px; }
  .alt { margin-top: 14px; padding: 20px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); display: grid; gap: 6px; }
  .alt h4 { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; }
  .alt .ar { font-size: 0.7em; color: var(--muted); }
  .alt p { color: var(--muted); max-width: 70ch; }
</style>
