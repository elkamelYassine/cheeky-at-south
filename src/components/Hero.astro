---
import { allSchedules, dur } from '../lib/schedule.mjs';
import { compute, defaultState } from '../lib/budget.mjs';
import { stops } from '../data/trip.mjs';
import photos from '../data/photos.json';
import { webpSrcset } from '../lib/img.mjs';
import CheekyLogo from './CheekyLogo.astro';

const sch = allSchedules();
const km = sch.reduce((a, s) => a + s.km, 0);
const driving = sch.reduce((a, s) => a + s.driving, 0);
const pp = compute(defaultState(km)).perPerson;

// Project the real route geometry into a small SVG (equirectangular, corrected for latitude).
const all = sch.flatMap((s) => s.line);
const lats = all.map((p) => p[0]), lons = all.map((p) => p[1]);
const [minLat, maxLat, minLon, maxLon] = [Math.min(...lats), Math.max(...lats), Math.min(...lons), Math.max(...lons)];
const k = Math.cos(((minLat + maxLat) / 2) * (Math.PI / 180));
const W = 420, pad = 18;
const sx = (W - pad * 2) / ((maxLon - minLon) * k);
const H = Math.round((maxLat - minLat) * sx + pad * 2);
const P = ([lat, lon]) => [pad + (lon - minLon) * k * sx, pad + (maxLat - lat) * sx];
const pathOf = (line) => {
  const step = Math.max(1, Math.floor(line.length / 260));
  return line.filter((_, i) => i % step === 0 || i === line.length - 1).map((p, i) => (i ? 'L' : 'M') + P(p).map((v) => v.toFixed(1)).join(' ')).join('');
};
const dayPaths = sch.map((s) => ({ id: s.day.id, color: s.day.color, d: pathOf(s.line) }));
const loop = dayPaths.map((p) => p.d).join('');
const pins = [
  ['sousse', 'Sousse', 'r'], ['tataouine-night', 'Tataouine', 'r'], ['douz-hotel', 'Douz', 'l'], ['tozeur-hotel', 'Tozeur', 'l'], ['gafsa', 'Gafsa', 'l'], ['matmata', 'Matmata', 'l'], ['ksar-ghilane', 'Ksar Ghilane', 'l'],
].map(([id, label, side]) => { const [x, y] = P([stops[id].lat, stops[id].lon]); return { x, y, label, side }; });
---
<section class="hero" id="top">
  <picture>
    <source type="image/webp" srcset={webpSrcset(photos['ksar-ghilane'][0])} sizes="100vw" />
    <img class="hero-bg" src={photos['ksar-ghilane'][0].src} alt="Dunes of the Grand Erg Oriental at Ksar Ghilane" fetchpriority="high" />
  </picture>
  <div class="hero-shade"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow kicker">A cheeky labs road trip · South of Tunisia · 4 friends, 1 car</p>
      <h1>
        <span class="visually-hidden">Cheeky at South</span>
        <span class="l1" aria-hidden="true"><CheekyLogo variant="wordmark" /></span>
        <span class="l2" aria-hidden="true">at South</span>
      </h1>
      <p class="ar hero-ar" lang="ar" dir="rtl">رحلة إلى الجنوب</p>
      <p class="lede">
        Ksour, troglodyte villages, Star Wars sets, the dunes of the Grand Erg and a salt lake you drive across.
        Saturday 7 to Tuesday 10 November 2026, from Sousse and back, then three nights by the sea in Hammam Sousse until Friday 13.
      </p>
      <dl class="facts">
        <div><dt>Days</dt><dd class="mono" data-count="4">4</dd></div>
        <div><dt>Kilometres</dt><dd class="mono" data-count={Math.round(km)}>{Math.round(km).toLocaleString('en-US')}</dd></div>
        <div><dt>At the wheel</dt><dd class="mono">{dur(driving)}</dd></div>
        <div><dt>Each, all in</dt><dd class="mono">≈{Math.round(pp / 10) * 10} TND</dd></div>
      </dl>
      <div class="cta">
        <a class="btn solid" href="#map">Open the map</a>
        <a class="btn ghost" href="#d1">Day by day</a>
      </div>
    </div>

    <figure class="loop" aria-label="Shape of the full loop">
      <svg viewBox={`0 0 ${W} ${H}`} role="img">
        <title>The full loop: Sousse, Matmata, Ksar Hadada, Tataouine, Ksar Ghilane, Douz, Tozeur, Gafsa, Kairouan, back to Hammam Sousse</title>
        {dayPaths.map((p, i) => (
          <path d={p.d} pathLength="1" class="seg" style={`--c:${p.color};--i:${i}`} />
        ))}
        {pins.map((p) => (
          <g class="pin" transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}>
            <circle r="4.5" />
            <text x={p.side === 'r' ? 9 : -9} y="4" text-anchor={p.side === 'r' ? 'start' : 'end'}>{p.label}</text>
          </g>
        ))}
        <circle r="6" class="car" opacity="0">
          <set attributeName="opacity" to="1" begin="2.6s" />
          <animateMotion dur="24s" repeatCount="indefinite" begin="2.6s" path={loop} rotate="auto" />
        </circle>
      </svg>
      <figcaption>
        {sch.map((s) => (
          <span style={`--c:${s.day.color}`}><i></i>Day {s.day.n}</span>
        ))}
      </figcaption>
    </figure>
  </div>
</section>

<script>
  // count-up for the hero numbers
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce)
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const end = Number(el.dataset.count);
      const t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / 1600);
        el.textContent = Math.round(end * (1 - Math.pow(1 - k, 3))).toLocaleString('en-US');
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
</script>

<style>
  .hero { position: relative; isolation: isolate; color: var(--on-photo); overflow: hidden; background: #0a0a0b; }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; animation: drift 30s ease-in-out infinite alternate; }
  .hero-shade {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(90deg, rgb(10 10 11 / 0.9) 0%, rgb(10 10 11 / 0.6) 45%, rgb(10 10 11 / 0.3) 100%),
      linear-gradient(0deg, #0a0a0b, transparent 35%);
  }
  @keyframes drift { from { transform: scale(1.04); } to { transform: scale(1.14) translateX(-2%); } }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: center; padding-block: clamp(56px, 9vw, 120px) clamp(48px, 7vw, 96px); }
  .kicker { color: #ff8a3d; }
  h1 { margin-block: 18px 12px; display: grid; gap: 0.12em; color: #f4f4f2; }
  .l1 { width: min(100%, 34rem); animation: rise 1.1s var(--ease-out-expo) both; }
  .l1 :global(svg) { width: 100%; }
  .l2 {
    font: 800 clamp(2.6rem, 1.4rem + 5.6vw, 6.4rem) / 0.9 var(--f-display); font-stretch: 116%; text-transform: uppercase;
    letter-spacing: -0.025em; color: #ff6a00; animation: rise 1.1s 0.12s var(--ease-out-expo) both;
  }
  @keyframes rise { from { transform: translateY(0.35em); opacity: 0; } }
  .hero-ar { font-size: var(--step-2); color: rgb(255 255 255 / 0.7); margin-bottom: 18px; text-align: left; }
  .lede { max-width: 52ch; font-size: var(--step-1); line-height: 1.45; color: rgb(255 255 255 / 0.92); }
  .facts { display: grid; grid-template-columns: repeat(4, auto); justify-content: start; gap: 8px 28px; margin: 30px 0 30px; }
  .facts div { display: grid; gap: 2px; }
  .facts dt { font: 600 0.72rem var(--f-mono); letter-spacing: 0.12em; text-transform: uppercase; color: rgb(255 255 255 / 0.65); }
  .facts dd { margin: 0; font: 800 var(--step-2) var(--f-display); font-stretch: 112%; letter-spacing: -0.02em; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .btn.solid { height: 48px; padding: 0 22px; font-size: 0.875rem; background: #ff6a00; color: #0a0a0b; box-shadow: none; }
  .btn.solid:hover { background: #ff8a3d; }
  .btn.ghost { height: 48px; padding: 0 22px; font-size: 0.875rem; background: rgb(255 255 255 / 0.06); color: #f4f4f2; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18); }
  .btn.ghost:hover { background: rgb(255 255 255 / 0.12); }

  .loop { margin: 0; background: rgb(17 17 19 / 0.6); border: 1px solid rgb(255 255 255 / 0.1); border-radius: 1.75rem; padding: 18px; backdrop-filter: blur(10px); }
  .loop svg { width: 100%; height: auto; max-height: 520px; overflow: visible; }
  .seg { fill: none; stroke: var(--c); stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 0.9s calc(0.35s + var(--i) * 0.55s) ease-in-out forwards; filter: drop-shadow(0 0 6px rgb(0 0 0 / 0.4)); }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .pin circle { fill: #0a0a0b; stroke: #ffffff; stroke-width: 2; }
  .pin text { fill: #ffffff; font: 600 12px var(--f-body); paint-order: stroke; stroke: rgb(18 14 20 / 0.7); stroke-width: 3px; }
  .car { fill: #ffffff; stroke: #ff6a00; stroke-width: 3; }
  .loop figcaption { display: flex; flex-wrap: wrap; gap: 6px 14px; justify-content: center; font: 600 0.78rem var(--f-mono); color: rgb(255 255 255 / 0.85); margin-top: 6px; }
  .loop figcaption span { display: inline-flex; align-items: center; gap: 6px; }
  .loop figcaption i { width: 18px; height: 4px; border-radius: 2px; background: var(--c); }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
    .loop { max-width: 440px; }
    .facts { grid-template-columns: repeat(2, auto); }
  }
  @media (prefers-reduced-motion: reduce) { .seg { stroke-dashoffset: 0; } .car { display: none; } }
</style>
